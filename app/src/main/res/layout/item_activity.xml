<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- Activity Icon -->
        <TextView
            android:id="@+id/tvActivityIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_activity_item_icon"
            android:gravity="center"
            android:text="₹"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvActivityItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Added expense"
            android:textColor="#212529"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvActivityAmount"
            app:layout_constraintStart_toEndOf="@id/tvActivityIcon"
            app:layout_constraintTop_toTopOf="@id/tvActivityIcon" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvActivityDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Food • 17 Sep 2026"
            android:textColor="#6C757D"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tvActivityAmount"
            app:layout_constraintStart_toEndOf="@id/tvActivityIcon"
            app:layout_constraintTop_toBottomOf="@id/tvActivityItemTitle" />

        <!-- Date -->
        <TextView
            android:id="@+id/tvActivityDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="Today"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tvActivityIcon"
            app:layout_constraintTop_toBottomOf="@id/tvActivityDescription" />

        <!-- Amount -->
        <TextView
            android:id="@+id/tvActivityAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹868.00"
            android:textColor="@color/primary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvActivityItemTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvActivityItemTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>